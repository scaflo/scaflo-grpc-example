{
  "name": "scaflo-grpc-example",
  "version": "1.0.0",
  "description": "Scaflo gRPC Example — full-stack showcase of all 4 gRPC communication patterns with React SSR",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build:client": "esbuild src/client.tsx --bundle --format=esm --outfile=public/client.js --minify --define:process.env.NODE_ENV='\"production\"'",
    "build": "pnpm run build:client && tsup",
    "test:grpc": "tsx src/testRunner.ts",
    "lint": "eslint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@scaflo/node-react-wrapper": "0.1.0-alpha.8",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
